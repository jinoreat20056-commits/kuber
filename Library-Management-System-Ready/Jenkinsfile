
pipeline {
    agent any

    environment {
        PROJECT_DIR = 'Library-Management-System-Ready'
        DOCKER_IMAGE = 'jino2006/library-management-system:v1'
        DOCKER_EXE = 'C:\\Users\\HP\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
        KUBECTL_EXE = 'C:\\Users\\HP\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\kubectl.exe'
        KUBE_CONFIG = 'C:\\Users\\HP\\.kube\\config'
    }

    stages {
        stage('Verify Project Files') {
            steps {
                bat '''
                    if not exist "%PROJECT_DIR%\\pom.xml" exit /b 1
                    if not exist "%PROJECT_DIR%\\Dockerfile" exit /b 1
                    if not exist "%PROJECT_DIR%\\deployment.yaml" exit /b 1
                    if not exist "%PROJECT_DIR%\\service.yaml" exit /b 1
                    echo All project files verified.
                '''
            }
        }

        stage('Build with Maven') {
            steps {
                dir('Library-Management-System-Ready') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Library-Management-System-Ready') {
                    bat '''
                        "%DOCKER_EXE%" build -t %DOCKER_IMAGE% .
                        if errorlevel 1 exit /b 1
                    '''
                }
            }
        }

        stage('Check Kubernetes') {
            steps {
                bat '''
                    "%KUBECTL_EXE%" --kubeconfig="%KUBE_CONFIG%" config current-context
                    if errorlevel 1 exit /b 1
                    "%KUBECTL_EXE%" --kubeconfig="%KUBE_CONFIG%" get nodes
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                dir('Library-Management-System-Ready') {
                    bat '''
                        "%KUBECTL_EXE%" --kubeconfig="%KUBE_CONFIG%" apply -f deployment.yaml
                        if errorlevel 1 exit /b 1

                        "%KUBECTL_EXE%" --kubeconfig="%KUBE_CONFIG%" apply -f service.yaml
                        if errorlevel 1 exit /b 1
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                bat '''
                    "%KUBECTL_EXE%" --kubeconfig="%KUBE_CONFIG%" rollout status deployment/library-management-system --timeout=180s
                    if errorlevel 1 exit /b 1

                    "%KUBECTL_EXE%" --kubeconfig="%KUBE_CONFIG%" get pods
                    if errorlevel 1 exit /b 1

                    "%KUBECTL_EXE%" --kubeconfig="%KUBE_CONFIG%" get services
                    if errorlevel 1 exit /b 1
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Maven build, Docker image build, and Kubernetes deployment verified.'
        }
        failure {
            echo 'FAILED: Check the first failing stage in Console Output.'
        }
    }
}
