
pipeline {
    agent any

    environment {
        PROJECT_DIR = 'Library-Management-System-Ready'

        DOCKER_IMAGE = 'jino2006/library-management-system'
        DOCKER_TAG = 'v1'

        DOCKER_EXE = 'C:\\Users\\HP\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
        KUBECTL_EXE = 'C:\\Users\\HP\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\kubectl.exe'
        KUBE_CONFIG = 'C:\\Users\\HP\\.kube\\config'
    }

    stages {

        stage('Verify Project Files') {
            steps {
                bat '''
                    if not exist "%PROJECT_DIR%\\pom.xml" (
                        echo ERROR: pom.xml missing
                        exit /b 1
                    )
                    if not exist "%PROJECT_DIR%\\Dockerfile" (
                        echo ERROR: Dockerfile missing
                        exit /b 1
                    )
                    if not exist "%PROJECT_DIR%\\deployment.yaml" (
                        echo ERROR: deployment.yaml missing
                        exit /b 1
                    )
                    if not exist "%PROJECT_DIR%\\service.yaml" (
                        echo ERROR: service.yaml missing
                        exit /b 1
                    )
                    echo All required files found.
                '''
            }
        }

        stage('Build with Maven') {
            steps {
                dir('Library-Management-System-Ready') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Library-Management-System-Ready') {
                    bat '''
                        "%DOCKER_EXE%" build -t %DOCKER_IMAGE%:%DOCKER_TAG% .
                        if errorlevel 1 exit /b 1
                    '''
                }
            }
        }

        stage('Verify Docker Hub Credential') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub-pat-new',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    powershell '''
                        $ErrorActionPreference = "Stop"

                        if ($env:DOCKER_USER -ne "jino2006") {
                            throw "Incorrect Docker Hub username in Jenkins credential."
                        }

                        if ([string]::IsNullOrWhiteSpace($env:DOCKER_PASS)) {
                            throw "Docker Hub token is empty."
                        }

                        Write-Output "Credential username is correct."
                        Write-Output "Token is present."
                        Write-Output "Token length: $($env:DOCKER_PASS.Length)"
                    '''
                }
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub-pat-new',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    powershell '''
                        $ErrorActionPreference = "Stop"

                        $startInfo = New-Object System.Diagnostics.ProcessStartInfo
                        $startInfo.FileName = $env:DOCKER_EXE
                        $startInfo.Arguments = "login --username `"$env:DOCKER_USER`" --password-stdin"
                        $startInfo.UseShellExecute = $false
                        $startInfo.RedirectStandardInput = $true
                        $startInfo.RedirectStandardOutput = $true
                        $startInfo.RedirectStandardError = $true
                        $startInfo.CreateNoWindow = $true

                        $process = New-Object System.Diagnostics.Process
                        $process.StartInfo = $startInfo

                        try {
                            [void]$process.Start()

                            $stdoutTask = $process.StandardOutput.ReadToEndAsync()
                            $stderrTask = $process.StandardError.ReadToEndAsync()

                            $process.StandardInput.Write($env:DOCKER_PASS)
                            $process.StandardInput.Close()

                            $process.WaitForExit()

                            $stdout = $stdoutTask.Result
                            $stderr = $stderrTask.Result

                            if ($stdout) {
                                Write-Output $stdout
                            }

                            if ($process.ExitCode -ne 0) {
                                Write-Output "Docker CLI returned a non-zero exit code."
                                if ($stderr) {
                                    Write-Output $stderr
                                }
                                throw "Docker Hub login failed. Check the PAT and Docker Hub account."
                            }

                            Write-Output "Docker Hub login succeeded."
                        }
                        finally {
                            if ($process -and -not $process.HasExited) {
                                $process.Kill()
                            }

                            if ($process) {
                                $process.Dispose()
                            }

                            Remove-Variable stdout, stderr -ErrorAction SilentlyContinue
                        }
                    '''
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                bat '''
                    "%DOCKER_EXE%" push %DOCKER_IMAGE%:%DOCKER_TAG%
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                dir('Library-Management-System-Ready') {
                    bat '''
                        "%KUBECTL_EXE%" --kubeconfig="%KUBE_CONFIG%" apply -f deployment.yaml
                        if errorlevel 1 exit /b 1

                        "%KUBECTL_EXE%" --kubeconfig="%KUBE_CONFIG%" apply -f service.yaml
                        if errorlevel 1 exit /b 1

                        "%KUBECTL_EXE%" --kubeconfig="%KUBE_CONFIG%" rollout status deployment/library-management-system --timeout=180s
                        if errorlevel 1 exit /b 1
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Maven build, Docker push, and Kubernetes deployment completed.'
        }

        failure {
            echo 'FAILED: Check the first error in Console Output.'
        }
    }
}
